# ---------------------------------------------------------------------------
# Monorepo environment template
#
# File ini adalah referensi variabel untuk SELURUH monorepo. Masing-masing
# app juga memiliki .env.example sendiri. Workflow umumnya:
#
#   cp apps/n8n/.env.example  apps/n8n/.env
#   # (apps/web memakai src/environments/*.ts, bukan .env)
#
# Jangan commit file .env yang sudah terisi secret.
# ---------------------------------------------------------------------------

# ==================== apps/web (Angular) ====================
# Konfigurasi runtime diambil dari src/environments/environment{,.production}.ts.
# Nilai di bawah hanya referensi dokumentasi.
WEB_N8N_BASE_URL=http://localhost:5678/webhook
WEB_REQUEST_TIMEOUT_MS=60000

# ==================== apps/n8n (backend) ====================
# Lihat apps/n8n/.env.example untuk daftar lengkap.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-to-a-32-char-random-value

# Microsoft SQL Server (dipakai workflow)
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DATABASE=TestDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# LLM provider untuk workflow SQL AI Agent
OPENAI_API_KEY=

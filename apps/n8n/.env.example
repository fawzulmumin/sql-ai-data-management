# n8n startup config
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# 32-char random string. Generate: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=change-me

# Basic auth untuk UI editor (opsional)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# n8n startup config
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# 32-char random string. Generate: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=change-me

# Signing key untuk JWT auth (min 32 char random, beda dari N8N_ENCRYPTION_KEY)
# Dipakai Auth Service untuk sign token + semua Validate Token node untuk verify.
JWT_SECRET=change-me-to-random-min-32-chars

# Basic auth untuk UI editor (recommended ON walau di lokal)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# CORS allowlist (production: ganti ke https://domain-anda)
N8N_CORS_ALLOW_ORIGIN=http://localhost:4200

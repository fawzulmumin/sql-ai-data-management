# ---------------------------------------------------------------------------
# n8n host configuration
# ---------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# n8n security
# ---------------------------------------------------------------------------
# 32-char random string. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-32-char-random-value

# Basic auth untuk UI editor n8n (opsional, kosongkan jika tidak dipakai)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Microsoft SQL Server (digunakan oleh workflow SQL AI)
# ---------------------------------------------------------------------------
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DATABASE=TestDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd

# Password untuk container MSSQL (lokal). Harus match dengan MSSQL_PASSWORD
# dan memenuhi complexity policy SQL Server.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
ACCEPT_EULA=Y

# ---------------------------------------------------------------------------
# OpenAI / LLM provider (dipakai di workflow SQL AI Agent)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
